# ============================================================
#  Backend environment TEMPLATE
#  Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
#  Bu fayl commit qilinadi — bu yerga HAQIQIY parol/kalit yozmang!
# ============================================================

# PostgreSQL: postgresql://<user>:<PAROL>@<host>:<port>/<baza>
# Ikkinchi qism (":" dan keyingi) — parol turadigan joy.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ai_assistant"
#
# cPanel'da (de.ahost.cloud) baza va foydalanuvchi nomiga cPanel login'ingiz
# prefiks qilib qo'shiladi — "PostgreSQL Databases" sahifasida ko'rinadigan
# TO'LIQ nomni oling, siz yozgan qismini emas:
#   DATABASE_URL="postgresql://cpuser_ai:PAROL@localhost:5432/cpuser_aidb"
#
# Parolda @ : / ? # kabi belgilar bo'lsa ULAR URL-encode qilinishi SHART,
# aks holda Prisma manzilni noto'g'ri bo'laklarga ajratadi va "Can't reach
# database server" beradi. Misol:  @ -> %40   # -> %23   / -> %2F
#   node -e "console.log(encodeURIComponent('PAROLINGIZ'))"
#
# --- Neon ishlatilsa (Render'dagi production shunday) ---
# DATABASE_URL — MUTLAQO pooled (PgBouncer) string bo'lsin, host nomida
# "-pooler" bo'ladi. Neon dashboard -> Connect -> "Pooled connection"ni
# yoqib nusxa oling. Aks holda Neon bepul compute 5 daqiqa harakatsizlikdan
# keyin uxlaganda ochiq ulanish o'ldiriladi va Prisma
# "terminating connection due to administrator command" (57P01) xatosini
# beradi — bu Render'da sayt 502 Bad Gateway qaytarishiga olib keladi.
#   DATABASE_URL="postgresql://user:PAROL@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require"
#
# `prisma db push`/`migrate` uchun esa pooler ISHLAMAYDI — o'sha buyruqni
# ishga tushirishdan oldin shu terminalda vaqtincha pooler'siz (host'da
# "-pooler" YO'Q) stringga almashtiring:
#   DATABASE_URL="postgresql://user:PAROL@ep-xxxx.region.aws.neon.tech/db?sslmode=require" npx prisma db push

# JWT imzolash kaliti — uzun tasodifiy satr:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# --- Boshlang'ich admin hisobi ------------------------------
# seed/reset FAQAT shu bitta hisobni yaratadi. Qolgan hamma foydalanuvchini
# admin ilova ichidan qo'shadi va login/parolini beradi. Jonli ishga
# tushirishdan oldin ALBATTA o'zgartiring va maxfiy saqlang.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_FULL_NAME="Administrator"

PORT=5000
NODE_ENV=development

# CORS: ruxsat berilgan frontend manzillari (vergul bilan, yoki *)
CORS_ORIGINS="http://localhost:5173"

# --- AI baholash: Gemini (ASOSIY grader) ---------------------
# Kalit: https://aistudio.google.com/apikey
# Bo'sh bo'lsa -> OpenRouter -> mock grader (soxta, matn uzunligi bo'yicha ball).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
# Kvota har bir model uchun alohida hisoblanadi. Asosiy model 429 (limit)
# qaytarganda baholash to'xtab qolmasligi uchun zaxira zanjiri kerak — oxirida
# eskiroq, kam band model tursin.
GEMINI_FALLBACK_MODELS="gemini-flash-latest,gemini-3.5-flash,gemini-2.5-flash"
# Bitta ish uchun nechta mustaqil baho olib o'rtachalash (1..5).
# DIQQAT: har bir sample = 1 ta API so'rovi, GEMINI_VERIFY=true yana bittasini
# qo'shadi. Ya'ni SAMPLES=3 + VERIFY=true => bitta ish uchun 4 ta so'rov.
# Bepul kalitda kunlik limit tez tugaydi va baholash "mock"ka tushib qoladi —
# bepul kalit uchun SAMPLES=1 qo'ying, 3 ni faqat pullik kalitda ishlating.
GEMINI_SAMPLES=1
GEMINI_VERIFY=false
GEMINI_TIMEOUT_MS=120000

# --- AI baholash: OpenRouter (zaxira, ixtiyoriy) -------------
OPENROUTER_API_KEY=""
SITE_URL="http://localhost:5000"
SITE_NAME="Independent Work Evaluation-AI"

# --- Fan bilim bazasi (knowledge base) ----------------------
# KB_DIR papkasidagi darslik/qollanmalar (.pdf/.docx/.pptx/.txt/.md) va fanga
# yuklangan kitoblardan AI javoblarni tekshiradi. Kop kitob = kop aniqlik.
KB_ENABLED=true
KB_DIR="../data-fayl"
KB_MAX_CHARS=24000

# Yuklangan fayllar papkasi
UPLOADS_DIR="./uploads"

# --- Jonli darslar (Live Classroom, Agora RTC) ---------------
# agora.io saytida BEPUL hisob oching -> Project Management -> "Create" bilan
# yangi loyiha yarating -> "Secured mode: APP ID + Token" ni tanlang (App
# Certificate shu bilan yoqiladi). Loyiha ro'yxatidan App ID'ni, "Config"
# tugmasidan Primary Certificate'ni ko'chiring. Oyiga ~10 000 daqiqagacha
# bepul. Bularsiz "Jonli darslar" bo'limi ishlamaydi — token so'ralganda aniq
# xato qaytadi.
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
# Berilgan tokenning amal qilish muddati, soniyada.
AGORA_TOKEN_TTL=3600
