{
  "name": "ai-assistant-backend",
  "version": "1.0.0",
  "description": "AI Assistant Platform — Node.js + Express + PostgreSQL backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node test/dynamic-rubric.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss",
